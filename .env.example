# Copy to .env and adjust
PORT=3000

# development | production — production switches logs to JSON and enforces a strong JWT_SECRET
NODE_ENV=development

# MySQL — structured data (users, courses, enrollments, progress)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=studyhub
MYSQL_PASSWORD=studyhub_pass
MYSQL_DATABASE=studyhub
# Set to true for managed providers that require TLS (Aiven, PlanetScale, RDS).
# Not needed on Railway, where the app reaches MySQL over the private network.
MYSQL_SSL=false

# MongoDB — unstructured data (note content)
MONGO_URI=mongodb://localhost:27017/studyhub

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- production only -------------------------------------------------------
# NODE_ENV=production
# MYSQL_SSL=true     # managed MySQL that requires TLS (Aiven, PlanetScale, RDS)
# PUBLIC_URL=https://studyhub-production-2c7b.up.railway.app   # verification + referral links
# CORS_ORIGIN=https://studyhub-production-2c7b.up.railway.app  # lock the API and sockets to your domain
# LOG_LEVEL=info
#
# Attachments and avatars are stored in MongoDB, so no upload volume is needed.
#
# --- email --------------------------------------------------------------
# Without a key, verification links are written to the log instead of sent.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# MAIL_FROM=StudyHub <onboarding@resend.dev>
#
# Demo mode: skip verification entirely so anyone can sign up and use the app.
# AUTO_VERIFY=true
