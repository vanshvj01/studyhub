# Copy to .env and adjust
PORT=3000

# development | production — production switches logs to JSON and enforces a strong JWT_SECRET
NODE_ENV=development

# MySQL — structured data (users, courses, enrollments, progress)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=studyhub
MYSQL_PASSWORD=studyhub_pass
MYSQL_DATABASE=studyhub
# Set to true for managed providers that require TLS (Aiven, PlanetScale, RDS).
# Not needed on Railway, where the app reaches MySQL over the private network.
MYSQL_SSL=false

# MongoDB — unstructured data (note content)
MONGO_URI=mongodb://localhost:27017/studyhub

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Where uploaded attachments and avatars are written. Leave unset locally to use
# public/uploads. In production point this at a mounted volume (on Railway,
# /data/uploads) or every redeploy wipes the files users have uploaded.
# UPLOAD_DIR=/data/uploads
